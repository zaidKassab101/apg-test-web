<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Apex Prospecting Group — Real Estate Appointment Setting</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<style>
  :root{
    --ink:#14213D;
    --ink-2:#1C2B4A;
    --ink-soft:#3B4A6B;
    --paper:#F8F6F0;
    --paper-2:#F1ECE0;
    --brass:#A9803C;
    --brass-light:#C9A45C;
    --slate:#5B6472;
    --line:#DED7C7;
    --line-dark:#33456B;
    --white:#FFFFFF;
    --shadow: 0 30px 60px -30px rgba(20,33,61,0.35);
    --radius: 2px;
  }

  *{ box-sizing:border-box; margin:0; padding:0; }
  html{ scroll-behavior:smooth; }
  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior:auto; }
    *{ animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; }
  }

  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter', sans-serif;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }

  h1,h2,h3,h4{ font-family:'Fraunces', serif; font-weight:500; line-height:1.08; color:var(--ink); letter-spacing:-0.01em; }
  a{ color:inherit; text-decoration:none; }
  ul{ list-style:none; }
  img,svg{ display:block; max-width:100%; }
  button{ font-family:inherit; cursor:pointer; }

  .eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    letter-spacing:0.16em;
    text-transform:uppercase;
    color:var(--brass);
    font-weight:500;
  }

  .wrap{ max-width:1180px; margin:0 auto; padding:0 32px; }
  section{ position:relative; }

  /* Focus visibility */
  a:focus-visible, button:focus-visible{
    outline:2px solid var(--brass);
    outline-offset:3px;
  }

  /* ---------------- NAV ---------------- */
  header{
    position:sticky; top:0; z-index:100;
    background:rgba(248,246,240,0.88);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .nav{
    display:flex; align-items:center; justify-content:space-between;
    padding:18px 32px;
    max-width:1180px; margin:0 auto;
  }
  .logo{
    display:flex; align-items:center; gap:10px;
    font-family:'Fraunces', serif; font-weight:600; font-size:20px; letter-spacing:-0.01em;
  }
  .logo .mark{
    width:32px; height:30px; flex:none; object-fit:contain;
    border:2px solid #000;
    border-radius:4px;
    box-sizing:border-box;
  }
  .logo .name{ display:flex; flex-direction:column; line-height:1; }
  .logo .name small{
    font-family:'IBM Plex Mono', monospace; font-size:9px; letter-spacing:0.18em; color:var(--brass);
    text-transform:uppercase; margin-top:5px; font-weight:500;
  }
  .nav-links{ display:flex; align-items:center; gap:36px; }
  .nav-links a{
    font-size:14px; font-weight:500; color:var(--ink-soft);
    position:relative; padding:4px 0;
  }
  .nav-links a::after{
    content:""; position:absolute; left:0; bottom:0; width:0; height:1px;
    background:var(--brass); transition:width 0.25s ease;
  }
  .nav-links a:hover::after{ width:100%; }
  .nav-cta{ display:flex; align-items:center; gap:20px; }
  .phone-link{ font-family:'IBM Plex Mono', monospace; font-size:13px; color:var(--ink); display:flex; align-items:center; gap:8px; }
  .phone-link svg{ width:15px; height:15px; stroke:var(--brass); }

  .btn{
    display:inline-flex; align-items:center; gap:8px;
    padding:12px 22px;
    font-size:14px; font-weight:600;
    border-radius:var(--radius);
    border:1px solid transparent;
    transition:all 0.25s ease;
    white-space:nowrap;
  }
  .btn-primary{ background:var(--ink); color:var(--paper); }
  .btn-primary:hover{ background:var(--brass); }
  .btn-ghost{ border-color:var(--ink); color:var(--ink); }
  .btn-ghost:hover{ background:var(--ink); color:var(--paper); }
  .btn-light{ background:var(--brass-light); color:var(--ink); }
  .btn-light:hover{ background:var(--paper); }

  .hamburger{ display:none; flex-direction:column; gap:5px; background:none; border:none; padding:6px; }
  .hamburger span{ width:22px; height:2px; background:var(--ink); display:block; }

  /* ---------------- HERO ---------------- */
  .hero{
    padding:96px 0 70px;
    position:relative;
  }
  .hero-grid{
    display:grid; grid-template-columns:1.05fr 0.85fr; gap:64px; align-items:center;
  }
  .hero h1{
    font-size:clamp(40px, 5.2vw, 66px);
    margin:18px 0 22px;
  }
  .hero h1 em{ font-style:normal; color:var(--brass); }
  .hero p.lede{
    font-size:18px; color:var(--slate); max-width:480px; margin-bottom:34px;
  }
  .hero-actions{ display:flex; align-items:center; gap:22px; flex-wrap:wrap; }

  /* ticket / appointment card signature element */
  .ticket-stage{ position:relative; display:flex; justify-content:center; }
  .ticket{
    position:relative;
    width:100%; max-width:360px;
    background:var(--white);
    border:1px solid var(--line);
    border-radius:6px;
    box-shadow:var(--shadow);
    transform:rotate(2.2deg);
    padding:28px 26px 24px;
  }
  .ticket::before{
    content:""; position:absolute; top:0; left:0; right:0; height:5px;
    background:linear-gradient(90deg, var(--brass), var(--brass-light));
    border-radius:6px 6px 0 0;
  }
  .ticket-top{ display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:18px; }
  .ticket-badge{
    font-family:'IBM Plex Mono', monospace; font-size:10.5px; letter-spacing:0.12em;
    text-transform:uppercase; color:var(--brass); font-weight:500;
  }
  .ticket-status{
    display:flex; align-items:center; gap:6px;
    font-family:'IBM Plex Mono', monospace; font-size:10.5px; font-weight:500;
    color:#2E6B4F; background:#E8F1EA; padding:4px 9px; border-radius:20px;
  }
  .ticket-status .dot{ width:6px; height:6px; border-radius:50%; background:#2E6B4F; }
  .ticket h3{ font-size:23px; margin-bottom:4px; }
  .ticket .sub{ font-size:13px; color:var(--slate); margin-bottom:18px; }
  .ticket-rule{ border-top:1px dashed var(--line); margin:16px 0; }
  .ticket-rows{ display:grid; grid-template-columns:1fr 1fr; gap:14px 10px; }
  .ticket-rows .row-label{ font-family:'IBM Plex Mono', monospace; font-size:9.5px; letter-spacing:0.1em; text-transform:uppercase; color:var(--slate); margin-bottom:3px; }
  .ticket-rows .row-value{ font-size:14px; font-weight:500; }
  .ticket-perf{
    position:absolute; left:-9px; top:50%; transform:translateY(-50%);
    width:18px; height:18px; background:var(--paper); border-radius:50%; border:1px solid var(--line);
  }
  .ticket-perf.right{ left:auto; right:-9px; }

  .ticket-shadow-card{
    position:absolute; width:100%; max-width:360px; height:88%;
    background:var(--paper-2); border:1px solid var(--line); border-radius:6px;
    transform:rotate(-6deg); top:6%; z-index:-1;
  }

  .hero-strip{
    margin-top:76px; padding-top:36px; border-top:1px solid var(--line);
    display:grid; grid-template-columns:repeat(4, 1fr); gap:24px;
  }
  .stat{ }
  .stat .num{
    font-family:'Fraunces', serif; font-size:clamp(28px,3vw,38px); font-weight:600; color:var(--ink);
    display:flex; align-items:baseline; gap:2px;
  }
  .stat .num .suffix{ color:var(--brass); font-size:0.65em; }
  .stat .label{ font-size:13px; color:var(--slate); margin-top:6px; max-width:190px; }

  /* ---------------- SECTION HEADS ---------------- */
  .section-head{ max-width:640px; margin-bottom:56px; }
  .section-head .eyebrow{ margin-bottom:14px; display:block; }
  .section-head h2{ font-size:clamp(30px,3.4vw,42px); margin-bottom:16px; }
  .section-head p{ color:var(--slate); font-size:16px; }

  section.pad{ padding:96px 0; }
  .divider{ border-top:1px solid var(--line); }

  /* ---------------- SERVICES ---------------- */
  .services-grid{
    display:grid; grid-template-columns:repeat(4, 1fr); gap:1px;
    background:var(--line); border:1px solid var(--line);
  }
  .service-card{
    background:var(--paper); padding:34px 26px; min-height:230px;
    display:flex; flex-direction:column; gap:16px;
    transition:background 0.25s ease;
  }
  .service-card:hover{ background:var(--white); }
  .service-card .icon{ width:32px; height:32px; stroke:var(--brass); stroke-width:1.4; fill:none; }
  .service-card h4{ font-size:18px; font-weight:600; font-family:'Inter',sans-serif; letter-spacing:-0.01em; }
  .service-card p{ font-size:14px; color:var(--slate); }

  /* ---------------- WHY APEX ---------------- */
  .why{ background:var(--ink); color:var(--paper); }
  .why .section-head p{ color:#AEB9D1; }
  .why .section-head .eyebrow{ color:var(--brass-light); }
  .why .section-head h2{ color:var(--paper); }
  .why-grid{ display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:start; }
  .why-list{ display:flex; flex-direction:column; }
  .why-item{
    display:flex; gap:20px; padding:24px 0; border-top:1px solid var(--line-dark);
  }
  .why-item:last-child{ border-bottom:1px solid var(--line-dark); }
  .why-item .icon{ width:22px; height:22px; stroke:var(--brass-light); fill:none; stroke-width:1.5; flex:none; margin-top:3px; }
  .why-item h4{ font-family:'Inter',sans-serif; font-size:16px; font-weight:600; color:var(--paper); margin-bottom:6px; }
  .why-item p{ font-size:14px; color:#AEB9D1; max-width:420px; }

  .why-panel{
    background:var(--ink-2); border:1px solid var(--line-dark); border-radius:6px; padding:38px;
  }
  .why-panel .eyebrow{ color:var(--brass-light); margin-bottom:18px; display:block; }
  .why-panel .quote{
    font-family:'Fraunces', serif; font-size:24px; font-weight:400; line-height:1.4; color:var(--paper);
    margin-bottom:24px;
  }
  .why-panel .quote span{ color:var(--brass-light); }
  .why-panel .attrib{ font-size:13px; color:#AEB9D1; }
  .why-panel .attrib strong{ color:var(--paper); font-weight:600; }
  .mini-bars{ display:flex; gap:6px; align-items:flex-end; height:60px; margin-top:28px; }
  .mini-bars .bar{ flex:1; background:linear-gradient(180deg, var(--brass-light), var(--brass)); border-radius:2px 2px 0 0; opacity:0.85; }

  /* ---------------- PROCESS ---------------- */
  .process-list{ display:grid; grid-template-columns:repeat(4,1fr); gap:0; position:relative; }
  .process-list::before{
    content:""; position:absolute; top:22px; left:6%; right:6%; height:1px; background:var(--line);
  }
  .process-item{ padding-right:24px; position:relative; }
  .process-num{
    font-family:'IBM Plex Mono', monospace; font-size:13px; color:var(--brass);
    background:var(--paper); display:inline-block; padding-right:14px; position:relative; z-index:2;
  }
  .process-item h4{ font-size:18px; margin:18px 0 10px; font-family:'Inter',sans-serif; font-weight:600; letter-spacing:-0.01em; }
  .process-item p{ font-size:14px; color:var(--slate); }

  /* ---------------- RESULTS BAND ---------------- */
  .results{ background:var(--paper-2); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  .results-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:40px; text-align:center; padding:64px 0; }
  .results .num{
    font-family:'Fraunces', serif; font-weight:600; font-size:clamp(34px,4vw,50px); color:var(--ink);
  }
  .results .num .suffix{ color:var(--brass); }
  .results .label{ font-size:13.5px; color:var(--slate); margin-top:8px; }

  /* ---------------- TESTIMONIALS ---------------- */
  .testi-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:28px; }
  .testi-card{
    background:var(--white); border:1px solid var(--line); border-radius:6px; padding:30px;
    display:flex; flex-direction:column; gap:20px;
  }
  .testi-card .stars{ display:flex; gap:3px; }
  .testi-card .stars svg{ width:14px; height:14px; fill:var(--brass); stroke:none; }
  .testi-card p{ font-size:15px; color:var(--ink-soft); line-height:1.6; }
  .testi-who{ display:flex; align-items:center; gap:12px; margin-top:auto; padding-top:16px; border-top:1px solid var(--line); }
  .testi-avatar{
    width:38px; height:38px; border-radius:50%; background:var(--ink); color:var(--paper);
    display:flex; align-items:center; justify-content:center; font-family:'Fraunces',serif; font-size:14px; flex:none;
  }
  .testi-who .name{ font-size:13.5px; font-weight:600; }
  .testi-who .role{ font-size:12px; color:var(--slate); }

  /* ---------------- REVIEWS ---------------- */
  .reviews-head{ display:flex; justify-content:space-between; align-items:flex-end; gap:40px; flex-wrap:wrap; margin-bottom:40px; }
  .reviews-head > div:first-child{ max-width:560px; margin-bottom:0; }
  .rating-summary{ text-align:right; flex:none; }
  .rating-num{ font-family:'Fraunces', serif; font-size:44px; font-weight:600; color:var(--ink); line-height:1; }
  .rating-num span{ font-size:0.4em; color:var(--slate); font-weight:400; }
  .rating-stars{ display:flex; gap:3px; justify-content:flex-end; margin:8px 0 6px; }
  .rating-stars svg{ width:15px; height:15px; fill:var(--brass); }
  .rating-label{ font-size:12.5px; color:var(--slate); }

  .review-tabs{ display:flex; gap:10px; margin-bottom:36px; }
  .review-tab{
    font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.06em;
    padding:9px 18px; border-radius:30px; border:1px solid var(--line);
    background:transparent; color:var(--slate); transition:all 0.2s ease;
  }
  .review-tab:hover{ border-color:var(--brass); color:var(--ink); }
  .review-tab.active{ background:var(--ink); border-color:var(--ink); color:var(--paper); }

  .review-grid{
    display:grid; grid-template-columns:repeat(3, 1fr); gap:24px;
    align-items:start;
  }
  .review-card{
    background:var(--white); border:1px solid var(--line); border-radius:6px;
    display:flex; flex-direction:column; overflow:hidden; transition:opacity 0.25s ease, transform 0.25s ease;
  }
  .review-card.is-hidden{ display:none; }
  .review-body{ padding:22px; display:flex; flex-direction:column; gap:14px; }
  .review-body .stars{ display:flex; align-items:center; gap:3px; height:14px; }
  .review-body .stars svg{ width:14px; height:14px; min-width:14px; max-width:14px; flex:none; fill:var(--brass); stroke:none; }
  .review-body p{ font-size:14.5px; color:var(--ink-soft); line-height:1.6; }
  .testi-who.no-border{ border-top:none; padding-top:0; margin-top:0; }

  .video-thumb{
    position:relative; aspect-ratio:16/9; overflow:hidden; cursor:pointer;
    background:var(--ink);
  }
  .video-thumb-bg{
    position:absolute; inset:0;
    background:
      radial-gradient(circle at 30% 20%, rgba(201,164,92,0.35), transparent 55%),
      linear-gradient(135deg, #14213D 0%, #1C2B4A 55%, #0F1830 100%);
  }
  .video-thumb-bg.alt{
    background:
      radial-gradient(circle at 75% 75%, rgba(201,164,92,0.3), transparent 55%),
      linear-gradient(135deg, #1C2B4A 0%, #14213D 60%, #0F1830 100%);
  }
  .play-btn{
    position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
    width:56px; height:56px; border-radius:50%; border:1.5px solid rgba(248,246,240,0.5);
    background:rgba(248,246,240,0.12); backdrop-filter:blur(4px);
    display:flex; align-items:center; justify-content:center; transition:all 0.25s ease;
  }
  .play-btn svg{ width:20px; height:20px; fill:var(--paper); margin-left:3px; }
  .video-thumb:hover .play-btn{ background:var(--brass); border-color:var(--brass); transform:translate(-50%,-50%) scale(1.08); }
  .video-tag{
    position:absolute; top:14px; left:14px;
    font-family:'IBM Plex Mono', monospace; font-size:10px; letter-spacing:0.1em; text-transform:uppercase;
    color:var(--paper); background:rgba(20,33,61,0.55); border:1px solid rgba(248,246,240,0.25);
    padding:5px 10px; border-radius:20px;
  }

  .video-modal{
    position:fixed; inset:0; background:rgba(10,16,30,0.9); z-index:1000;
    display:flex; align-items:center; justify-content:center; padding:24px;
    opacity:0; pointer-events:none; transition:opacity 0.25s ease;
  }
  .video-modal.open{ opacity:1; pointer-events:auto; }
  .video-modal-inner{ width:100%; max-width:860px; position:relative; }
  .video-modal-frame{
    position:relative; width:100%; aspect-ratio:16/9; background:#000; border-radius:6px; overflow:hidden;
  }
  .video-modal-frame iframe, .video-modal-frame video{ position:absolute; inset:0; width:100%; height:100%; border:0; }
  .video-modal-close{
    position:absolute; top:-44px; right:0; background:none; border:none; color:var(--paper);
    font-size:32px; line-height:1; padding:6px;
  }

  @media (max-width: 980px){
    .review-grid{ grid-template-columns:repeat(2,1fr); }
  }
  @media (max-width: 720px){
    .review-grid{ grid-template-columns:1fr; }
    .reviews-head{ flex-direction:column; align-items:flex-start; }
    .rating-summary{ text-align:left; }
    .rating-stars{ justify-content:flex-start; }
  }

  /* ---------------- CTA BANNER ---------------- */
  .cta-banner{
    background:var(--ink); color:var(--paper); border-radius:8px; padding:64px 56px;
    display:flex; align-items:center; justify-content:space-between; gap:40px;
    position:relative; overflow:hidden;
  }
  .cta-banner::after{
    content:""; position:absolute; right:-60px; top:-60px; width:220px; height:220px;
    border:1px solid var(--line-dark); border-radius:50%;
  }
  .cta-banner h2{ color:var(--paper); font-size:clamp(26px,3vw,36px); max-width:480px; }
  .cta-banner p{ color:#AEB9D1; margin-top:12px; font-size:15px; max-width:440px; }
  .cta-actions{ display:flex; gap:16px; flex-wrap:wrap; flex:none; }

  /* ---------------- FOOTER ---------------- */
  footer{ background:var(--ink); color:#AEB9D1; padding-top:64px; }
  .footer-grid{ display:grid; grid-template-columns:1.4fr 1fr 1fr 1fr; gap:48px; padding-bottom:56px; }
  .footer-logo{ display:flex; align-items:center; gap:10px; color:var(--paper); font-family:'Fraunces',serif; font-size:19px; font-weight:600; margin-bottom:14px; }
  .footer-col h5{ font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:var(--brass-light); margin-bottom:18px; font-weight:500; }
  .footer-col p, .footer-col a{ font-size:14px; margin-bottom:10px; display:block; color:#AEB9D1; }
  .footer-col a:hover{ color:var(--paper); }
  .footer-bottom{
    border-top:1px solid var(--line-dark); padding:22px 0; display:flex; justify-content:space-between; align-items:center;
    font-size:13px; color:#7C88A6; flex-wrap:wrap; gap:12px;
  }
  .social{ display:flex; gap:14px; }
  .social a{ width:32px; height:32px; border:1px solid var(--line-dark); border-radius:50%; display:flex; align-items:center; justify-content:center; }
  .social svg{ width:14px; height:14px; stroke:#AEB9D1; fill:none; }
  .social a:hover{ border-color:var(--brass-light); }
  .social a:hover svg{ stroke:var(--brass-light); }

  /* ---------------- RESPONSIVE ---------------- */
  @media (max-width: 980px){
    .hero-grid{ grid-template-columns:1fr; }
    .ticket-stage{ margin-top:20px; }
    .why-grid{ grid-template-columns:1fr; }
    .services-grid{ grid-template-columns:repeat(2,1fr); }
    .process-list{ grid-template-columns:repeat(2,1fr); row-gap:36px; }
    .process-list::before{ display:none; }
    .results-grid{ grid-template-columns:repeat(2,1fr); }
    .testi-grid{ grid-template-columns:1fr; }
    .footer-grid{ grid-template-columns:1fr 1fr; }
    .cta-banner{ flex-direction:column; align-items:flex-start; }
  }
  @media (max-width: 720px){
    .nav-links{ display:none; }
    .hamburger{ display:flex; }
    .phone-link{ display:none; }
    .hero{ padding:56px 0 40px; }
    .hero-strip{ grid-template-columns:repeat(2,1fr); row-gap:28px; }
    .services-grid{ grid-template-columns:1fr; }
    .process-list{ grid-template-columns:1fr; }
    .results-grid{ grid-template-columns:1fr 1fr; }
    section.pad{ padding:64px 0; }
    .footer-grid{ grid-template-columns:1fr; gap:32px; }
  }
</style>
</head>
<body>

<header>
  <nav class="nav">
    <a href="#top" class="logo">
      <img class="mark" src="data:image/png;base64," alt="">
      <span class="name">Apex<small>Prospecting Group</small></span>
    </a>
    <div class="nav-links">
      <a href="#services">Services</a>
      <a href="#why">Why Apex</a>
      <a href="#process">Process</a>
      <a href="#reviews">Reviews</a>
